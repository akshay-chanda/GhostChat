PORT=3000
NODE_ENV=development

# Leave unset for a single-instance deployment — storage/memoryStore.js
# is used by default. Set this to enable storage/redisStore.js and the
# Socket.IO Redis adapter for horizontal scaling (see config/redis.js
# for the caveat about that swap not being fully wired yet).
REDIS_URL=

# Legacy server secret retained for compatibility with the current
# production environment configuration. Required when NODE_ENV is
# "production". Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Frontend origin used to generate invite links.
# For local development, this should match the Vite frontend origin.
FRONTEND_URL=http://localhost:5173

# CORS origin for the frontend.
CORS_ORIGIN=http://localhost:5173

# Where encrypted file uploads are written on disk. Relative paths
# resolve against the process's working directory.
FILE_STORAGE_PATH=./uploads

# Bytes. 20MB to match the app's stated file-size limit.
MAX_FILE_SIZE=20971520