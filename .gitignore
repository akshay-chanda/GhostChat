# Dependencies
node_modules/

# Build output
dist/
build/

# Environment files — real secrets never get committed; only
# .env.example files (frontend/.env.example, backend/.env.example)
# are tracked.
.env
.env.local
.env.*.local

# Uploaded files are ephemeral by design — nothing here should ever
# be committed except the placeholder that keeps the directory itself
# tracked.
backend/uploads/*
!backend/uploads/.gitkeep

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/

# Editor/OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docker
*.pid
