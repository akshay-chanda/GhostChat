# Base path for HTTP API requests (services/api.js). In dev, Vite
# proxies "/api" to the backend (see vite.config.js), so this can
# stay relative. Set to a full URL only for a separate-origin deploy.
VITE_API_BASE_URL=/api

# Socket.IO server URL. "/" lets socket.io-client use the current
# origin, relying on the same dev proxy / same-origin production
# deploy as the API above.
VITE_SOCKET_URL=/
